# 백엔드 환경변수 — `.env`로 복사(커밋되지 않음)
NODE_ENV=development
PORT=3000
# 호스트에서 db:push·db:seed·start:dev 실행 시 DB 접속 주소.
# compose가 컨테이너 5432를 호스트 55432로 매핑(Windows 예약 포트 회피, docker-compose.yml 참고)하므로 호스트는 55432.
DATABASE_URL=postgresql://bmc:bmc@localhost:55432/bmc
# AI 자연어 검색(P5) — Gemini 키는 서버에만 보관(프론트 번들 미노출).
# 미설정 시 POST /api/search/nl 은 503. 키 발급: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
