# 프론트 환경변수 예시. 실제 값은 .env.local(git 무시)에 둔다.

# 실 백엔드로 연결할 때만 설정. 비우면 MSW 목서버 사용.
# VITE_API_BASE_URL=http://localhost:3000/

# 목데이터(MSW)를 쓰면서 AI만 실백엔드로 위임하는 하이브리드 데모 스위치.
# 설정 시: MSW가 /api/search/nl을 가로채지 않고 Vite 프록시→백엔드(서버 키)로 넘긴다.
#   → 프론트 VITE_GEMINI_API_KEY는 비우고 키는 backend/.env(GEMINI_API_KEY)에만 둔다(미노출).
# 미설정 시: MSW가 요약 목만 반환(순수 프론트 개발). 백엔드가 떠 있어야 유효.
# VITE_AI_PROXY=1

# AI 자연어 검색(Gemini) 프론트 직접 호출용 키. 번들에 노출되니 공개 데모엔 VITE_AI_PROXY 권장.
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-flash-latest

# Naver 지도(NCP Dynamic Map) Client ID. NCP 콘솔 Application에 Dynamic Map 선택 +
# Web 서비스 URL(포트·경로 제외 호스트만: http://localhost) 등록 필요.
VITE_NAVER_MAP_CLIENT_ID=your-ncp-map-client-id
